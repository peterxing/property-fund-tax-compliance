{
  "name": "property-fund-tax-compliance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Property fund tax compliance workspace for Australian AMIT/MIT trusts and Singapore S-REITs: trial balance to distribution, withholding, investor notices, cost base and sign-off. Static demo with fictional data.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\" && node --disable-warning=ExperimentalWarning --import ./scripts/register-esbuild.mjs --test \"test/**/*.test.tsx\"",
    "test:engine": "node --disable-warning=ExperimentalWarning --test \"test/engine/**/*.test.ts\"",
    "test:domain": "node --disable-warning=ExperimentalWarning --test \"test/domain/**/*.test.ts\"",
    "test:ui": "node --disable-warning=ExperimentalWarning --import ./scripts/register-esbuild.mjs --test \"test/ui/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs:rules": "node --disable-warning=ExperimentalWarning scripts/docs/write-docs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.0",
    "pdfkit": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dom-accessibility-api": "^0.7.1",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0"
  }
}
